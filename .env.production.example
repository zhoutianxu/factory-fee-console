FACTORY_FEE_SECRET_KEY=replace-with-a-long-random-string

# Use 127.0.0.1 when Nginx is the public entrypoint.
# Use 0.0.0.0 only when ECS security group limits trusted office IPs.
FACTORY_FEE_BIND_IP=127.0.0.1
FACTORY_FEE_PORT=5050

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

BACKUP_RETENTION_DAYS=14
